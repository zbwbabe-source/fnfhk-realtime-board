# Snowflake Connection
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USERNAME=SVC_ORG_FPA
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SNOWFLAKE_DATABASE=SAP_FNF
SNOWFLAKE_SCHEMA=DASH
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_ROLE=your_role

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# Vercel Cron Protection
CRON_SECRET=your_random_secret_key_here

# Weekly Email
WEEKLY_EMAIL_ENABLED=0
WEEKLY_EMAIL_FROM=dashboard@example.com
WEEKLY_EMAIL_TO=leader1@example.com,leader2@example.com
WEEKLY_EMAIL_DASHBOARD_URL=https://your-app.vercel.app/dashboard
RESEND_API_KEY=re_your_resend_api_key

# Node Environment
NODE_ENV=production
